# Database URL:
# For local zero-config evaluation (SQLite):
DATABASE_URL="file:./dev.db"

# For production / PostgreSQL (e.g. Supabase, Neon):
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres?sslmode=require"

# JWT Secret for signing auth tokens (change in production)
JWT_SECRET="hcm-lite-super-secure-production-jwt-token-saylani-hackathon-2026"

# Optional Initial Admin Bootstrap (can also be created via /setup onboarding)
ADMIN_EMAIL="admin@hcmlite.com"
ADMIN_PASSWORD="AdminPassword123!"

# AI Assistant Configuration
# Supported providers: openai, groq, gemini, openrouter, anthropic (standard OpenAI-compatible API)
AI_PROVIDER="openai"
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_API_KEY=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
